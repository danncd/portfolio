{
    "name": "portfolio",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "predev": "node --conditions=react-server scripts/validate-content.ts",
        "dev": "next dev",
        "prebuild": "node --conditions=react-server scripts/validate-content.ts",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "validate": "node --conditions=react-server scripts/validate-content.ts",
        "test": "node --conditions=react-server --test src/features/content/tests/*.test.ts src/features/navigation/tests/*.test.ts src/features/shell/tests/*.test.ts && node --import tsx --test src/features/markdown/tests/*.test.tsx",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:markdown": "node --import tsx --test src/features/markdown/tests/*.test.tsx"
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "highlight.js": "^11.11.1",
        "lowlight": "^3.3.0",
        "next": "16.3.6",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "server-only": "^0.0.1",
        "unified": "^11.0.5",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.3.6",
        "prettier": "3.9.9",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "typescript": "^5"
    }
}
